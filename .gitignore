# PokerMachine, cio' che non entra nel repository.
# Autori: Gabriele Battaglia (IZ4APU) & ClaudIA (Claude Fable 5.1, UltraCode).
# Il salvataggio pokermachine_data.json resta tracciato di proposito: e' il
# modo di portare il gruzzolo fra le macchine. Restano fuori le sue copie di
# lavoro, il vecchio pickle convertito, e cio' che produce la compilazione.

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# PyInstaller e archivio di release
build/
dist/
*.zip
*.manifest
*.spec
!pokermachine.spec

# Copie di lavoro del salvataggio
*.bak
*.tmp
*.illeggibile
*.migrato
pokermachine_data.pkl
